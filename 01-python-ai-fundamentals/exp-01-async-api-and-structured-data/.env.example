# Active provider selection: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# Google Gemini API (default free-tier cloud option via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI API (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Local Ollama (optional, zero-cost offline execution on Apple Silicon)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# HTTP client resilience settings
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2
