# Active provider selection: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# Google Gemini API (default free-tier cloud option via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI Responses API (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages API (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Local Ollama (optional, zero-cost offline execution)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Safety, policy & HTTP settings
AGENT_MAX_STEPS=5
MAX_REFUND_USD=500.0
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=2
