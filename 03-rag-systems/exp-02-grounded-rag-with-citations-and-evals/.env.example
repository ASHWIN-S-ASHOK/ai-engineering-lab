# Generation LLM provider: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# Embedding provider: gemini | openai | ollama
# (Anthropic has no native embedding endpoint; pair Claude generation with Gemini/OpenAI/Ollama.)
EMBEDDING_PROVIDER=gemini

# Google Gemini (default free-tier cloud option via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional for generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Local Ollama (optional, zero-cost offline execution)
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Hybrid RAG settings
SQLITE_DB_PATH=:memory:
RRF_K=60
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=2
