# Embedding provider selection: gemini | openai | ollama
# Note: Anthropic does not expose a native embedding endpoint; pair Claude generation with one of these.
EMBEDDING_PROVIDER=gemini

# Google Gemini Embeddings (default free-tier cloud option via Google AI Studio)
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI Embeddings (optional)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama Embeddings (optional, zero-cost offline execution on Apple Silicon)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# HTTP client resilience settings
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=2
